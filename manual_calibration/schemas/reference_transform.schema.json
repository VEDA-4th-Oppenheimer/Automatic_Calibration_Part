{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/manual-calibration/reference-transform.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transform"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "warning": {"type": "string"},
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_frame", "child_frame", "convention", "rotation_matrix", "translation_m"],
      "properties": {
        "parent_frame": {"const": "lidar_scan"},
        "child_frame": {"const": "marker_board"},
        "convention": {"const": "p_parent = R_parent_child * p_child + t_parent_child"},
        "rotation_matrix": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
        },
        "translation_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
      }
    }
  }
}
